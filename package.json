{
  "name": "classroom-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:check": "tsx scripts/cf-preflight.ts",
    "test:workers": "bash scripts/test-workers.sh"
  },
  "dependencies": {
    "next": "16.3.4",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.56.0",
    "@types/node": "22.15.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "wrangler": "4.130.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
