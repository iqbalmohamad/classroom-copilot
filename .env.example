# ---------------------------------------------------------------------------
# Classroom Copilot — environment configuration
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase or any Postgres 14+).
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler.
#
# Do NOT append ?pgbouncer=true. postgres.js forwards unknown URL parameters to
# the server as startup options, and Postgres rejects the connection with
# 'unrecognized configuration parameter "pgbouncer"'. The pooler is already
# handled by the driver's prepare:false setting.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/classroom_copilot

# Max pooled connections per server instance. Keep small on serverless hosts.
# Leave the key out entirely rather than setting it empty.
DATABASE_POOL_MAX=5

# TLS for the database connection. Anything but a loopback host defaults to
# 'require'; set 'disable' only for a local server that does not speak TLS.
# DATABASE_SSL=require

# Public origin, used to build join URLs and QR codes. Set this in production.
# Not a NEXT_PUBLIC_ variable on purpose: those are inlined at build time, so
# they cannot be changed from a hosting dashboard without rebuilding.
# APP_ORIGIN=https://classroom-copilot.example.com

# ---------------------------------------------------------------------------
# Optional: AI Class Read (advisory only). Leave unset to disable the feature
# entirely — the classroom works without it.
# ---------------------------------------------------------------------------
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Test harnesses only. Never set these on a deployment.
# ---------------------------------------------------------------------------
# CC_DISABLE_RATE_LIMIT=1        # every request in a suite shares one address
# CC_ALLOW_INSECURE_COOKIES=1    # local http:// runs, drops the Secure flag
